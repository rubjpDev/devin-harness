{
  "SessionStart": [
    {
      "hooks": [
        { "type": "command", "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && ./acu.sh >/dev/null 2>&1 || true", "timeout": 15 }
      ]
    }
  ],

  "SessionEnd": [
    {
      "hooks": [
        { "type": "command", "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && ./acu.sh >/dev/null 2>&1 || true", "timeout": 30 }
      ]
    }
  ],

  "PreToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        { "type": "command", "command": "./scripts/guard-prod.sh", "timeout": 10 }
      ]
    }
  ],

  "PostToolUse": [
    {
      "matcher": "^(edit|write)$",
      "hooks": [
        { "type": "command", "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && ./scripts/redaction-scan.sh 2>&1 | grep -E '^\\[FAIL\\]' || true", "timeout": 30 }
      ]
    }
  ],

  "Stop": [
    {
      "hooks": [
        { "type": "command", "command": "./scripts/stop-gate.sh", "timeout": 300 }
      ]
    }
  ]
}
