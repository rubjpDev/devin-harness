{
  // devin-sdd-harness — project config. Committed.
  // Personal overrides go in .devin/config.local.json (gitignored).
  //
  // The orchestrator (main session) model is set here. Per-agent models live in
  // each .devin/agents/*.md frontmatter — do NOT force a single model globally,
  // it breaks the ACU tiering.
  //
  // ★ Verify these ids against YOUR account: devin models list
  //   Tiering (see README): triage & spec_creator -> gpt-5-4,
  //   coder -> swe-1-7, validator & orchestrator -> sonnet-4-5.
  //   If an id below is rejected, copy the exact string from `devin models list`
  //   into here and into the matching .devin/agents/*.md frontmatter.
  "model": "sonnet-4-5",

  "subagents_enabled": true,

  // Do not import Cursor/Windsurf/Claude rule files — this harness owns its
  // context and stray rules from another tool are a debugging nightmare.
  "read_config_from": [],

  "permissions": {
    "allow": [
      "exec(./init.sh)",
      "exec(./acu.sh:*)",
      "exec(./scripts/redaction-scan.sh)",
      "exec(git status:*)",
      "exec(git diff:*)",
      "exec(git log:*)",
      "exec(kubectl get:*)",
      "exec(kubectl describe:*)",
      "exec(kubectl logs:*)",
      "exec(kubectl top:*)",
      // Dry-runs go through the wrapper: `kubectl apply` is denied outright
      // below, and deny wins over allow, so a bare --dry-run would be blocked.
      "exec(./scripts/k8s-validate.sh:*)",
      "exec(helm lint:*)",
      "exec(helm template:*)",
      "exec(yamllint:*)",
      "exec(jq:*)"
    ],
    "deny": [
      // PROD and PRE are read-only for every agent, always. The human applies.
      "exec(kubectl apply:*)",
      "exec(kubectl delete:*)",
      "exec(kubectl scale:*)",
      "exec(kubectl rollout:*)",
      "exec(kubectl edit:*)",
      "exec(kubectl patch:*)",
      "exec(kubectl drain:*)",
      "exec(kubectl cordon:*)",
      "exec(helm upgrade:*)",
      "exec(helm install:*)",
      "exec(helm uninstall:*)",
      "exec(helm rollback:*)",
      "exec(terraform apply:*)",
      "exec(terraform destroy:*)",
      "exec(git push:*)"
    ]
  }
}
